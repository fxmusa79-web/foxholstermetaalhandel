{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foxholstermetaalhandel",
  "compatibility_date": "2026-09-20",
  "main": "./worker/index.js",
  "keep_vars": true,
  "vars": {
    "CONTACT_EMAIL": "info@foxholstermetaalhandel.nl",
    "FROM_EMAIL": "website@foxholstermetaalhandel.nl",
    "FROM_NAME": "Foxholster Metaalhandel"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foxholster-metaal",
      "database_id": "41b4dafd-440e-446c-9098-f4b65c747a41",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "foxholster-bucket"
    }
  ]
}
