{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foxholstermetaalhandel",
  "compatibility_date": "2026-09-20",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
